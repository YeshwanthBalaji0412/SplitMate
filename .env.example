# Copy this file to apps/mobile/.env and fill in the values from the
# Supabase dashboard (Project Settings -> API). Expo loads EXPO_PUBLIC_*
# variables from apps/mobile/.env at build time, not from the repo root.
# Never commit the populated apps/mobile/.env file.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
