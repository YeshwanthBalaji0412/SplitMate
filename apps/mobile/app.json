{
  "expo": {
    "name": "SplitMate",
    "slug": "splitmate",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "splitmate",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.splitmate.app",
      "deploymentTarget": "16.0",
      "infoPlist": {
        "NSCameraUsageDescription": "SplitMate uses the camera to scan receipts.",
        "NSPhotoLibraryUsageDescription": "SplitMate accesses your photos to scan receipts."
      }
    },
    "android": {
      "package": "com.splitmate.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "SplitMate accesses your photos to scan receipts.",
          "cameraPermission": "SplitMate uses the camera to scan receipts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
